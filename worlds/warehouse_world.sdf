<?xml version="1.0" ?>
<sdf version="1.9">

  <world name="warehouse_world">

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>

    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>

    <plugin  filename='ignition-gazebo-sensors-system'
            name='ignition::gazebo::systems::Sensors'/>

    <!-- ================= LIGHTING ================= -->

    <light name="warehouse_light_1" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <light name="warehouse_light_2" type="point">
      <pose>0 0 5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>30</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light name="warehouse_light_3" type="point">
      <pose>-7 -4 5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <attenuation>
        <range>25</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <light name="warehouse_light_4" type="point">
      <pose>7 4 5 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <attenuation>
        <range>25</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
    </light>

    <!-- ================= FLOOR ================= -->

    <model name="warehouse_floor">
      <static>true</static>
      <link name="floor">

        <collision name="collision">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>20 16 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>20 16 0.1</size>
            </box>
          </geometry>
         <material>
          <ambient>0.32 0.32 0.32 1</ambient>
          <diffuse>0.42 0.42 0.42 1</diffuse>
          <specular>0.08 0.08 0.08 1</specular>
        </material>
        </visual>

      </link>
    </model>

    <!-- ================= WALLS ================= -->

    <model name="wall_left">
      <static>true</static>
      <link name="link">
        <pose>-10 0 2 0 0 0</pose>

        <collision name="collision">
          <geometry><box><size>0.2 16 4</size></box></geometry>
        </collision>

        <visual name="visual">
          <geometry><box><size>0.2 16 4</size></box></geometry>
          <material>
            <ambient>0.20 0.22 0.24 1</ambient>
            <diffuse>0.28 0.30 0.32 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_right">
      <static>true</static>
      <link name="link">
        <pose>10 0 2 0 0 0</pose>

        <collision name="collision">
          <geometry><box><size>0.2 16 4</size></box></geometry>
        </collision>

        <visual name="visual">
          <geometry><box><size>0.2 16 4</size></box></geometry>
          <material>
            <ambient>0.20 0.22 0.24 1</ambient>
            <diffuse>0.28 0.30 0.32 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_front">
      <static>true</static>
      <link name="link">
        <pose>0 -8 2 0 0 0</pose>

        <collision name="collision">
          <geometry><box><size>20 0.2 4</size></box></geometry>
        </collision>

        <visual name="visual">
          <geometry><box><size>20 0.2 4</size></box></geometry>
          <material>
            <ambient>0.20 0.22 0.24 1</ambient>
            <diffuse>0.28 0.30 0.32 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_back">
      <static>true</static>
      <link name="link">
        <pose>0 8 2 0 0 0</pose>

        <collision name="collision">
          <geometry><box><size>20 0.2 4</size></box></geometry>
        </collision>

        <visual name="visual">
          <geometry><box><size>20 0.2 4</size></box></geometry>
          <material>
            <ambient>0.20 0.22 0.24 1</ambient>
            <diffuse>0.28 0.30 0.32 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= RACKS ================= -->

    <include>
      <uri>model://rack</uri>
      <name>rack_1</name>
      <pose>-6 3 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://rack</uri>
      <name>rack_2</name>
      <pose>0 3 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://rack</uri>
      <name>rack_3</name>
      <pose>6 3 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://rack</uri>
      <name>rack_4</name>
      <pose>-6 -2 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://rack</uri>
      <name>rack_5</name>
      <pose>0 -2 0 0 0 0</pose>
    </include>

    <include>
      <uri>model://rack</uri>
      <name>rack_6</name>
      <pose>6 -2 0 0 0 0</pose>
    </include>

    <!-- ================= LOADING AREA ================= -->

    <model name="loading_area">
      <static>true</static>
      <link name="link">
        <pose>0 -6.5 0.01 0 0 0</pose>

        <visual name="visual">
          <geometry>
            <box><size>8 2 0.02</size></box>
          </geometry>
          <material>
            <ambient>0.9 0.65 0.1 1</ambient>
            <diffuse>0.95 0.75 0.15 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ================= OBSTACLES ================= -->

    <model name="obstacle_1">
      <static>true</static>
      <link name="link">
        <pose>-8 -5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry><box><size>1 1 1</size></box></geometry>
        </collision>

        <visual name="visual">
          <geometry><box><size>1 1 1</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.1 1</ambient>
            <diffuse>0.9 0.25 0.1 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <link name="link">
        <pose>8 -5 0.5 0 0 0</pose>

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.5</radius>
              <length>1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.45 0.8 1</ambient>
            <diffuse>0.15 0.55 0.9 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
